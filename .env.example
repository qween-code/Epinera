# ---- Genel ----
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-secret
TIMEZONE=Europe/Istanbul

# ---- Postgres ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@postgres:5432/sentinel

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Auth (tek kullanıcı) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---- AI Provider ----
# "anthropic" veya "ollama"
AI_PROVIDER=anthropic
AI_TEXT_MODEL=claude-opus-4-7
AI_VISION_MODEL=claude-opus-4-7
AI_FALLBACK_PROVIDER=ollama

ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TEXT_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=qwen2-vl:7b

# ---- OCR ----
OCR_LANGS=tr,en

# ---- SMTP (mail / ticket) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sentinel@local
SMTP_TLS=true
TICKET_TO_EMAIL=destek@example.com

# ---- ProManage ----
PROMANAGE_BASE_URL=
PROMANAGE_USERNAME=
PROMANAGE_PASSWORD=
PROMANAGE_LOG_STREAM_URL=
# Yöntem: "websocket", "sse", "poll"
PROMANAGE_STREAM_MODE=poll
PROMANAGE_POLL_INTERVAL_SECONDS=5

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
