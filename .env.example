# ---- Genel ----
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-secret
TIMEZONE=Europe/Istanbul

# ---- Postgres ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@postgres:5432/sentinel

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Auth (tek kullanıcı) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---- AI Provider ----
# "anthropic" | "ollama" | "openai_compat"
AI_PROVIDER=ollama
AI_FALLBACK_PROVIDER=anthropic

# Anthropic (API)
ANTHROPIC_API_KEY=
AI_TEXT_MODEL=claude-opus-4-7
AI_VISION_MODEL=claude-opus-4-7

# Ollama (on-prem, ÜCRETSİZ — varsayılan)
# Önerilen güncel modeller (2026):
#   text     : qwen3.5:9b   |  gemma4:e4b      |  qwen3.6:27b
#   vision   : qwen3-vl:8b  |  qwen3.5:9b      |  gemma4:e4b   (hepsi multimodal)
#   embedding: bge-m3 (1024 dim, çok dilli) — pgvector boyutuyla uyumlu olmalı
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TEXT_MODEL=qwen3.5:9b
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_EMBED_MODEL=bge-m3

# OpenAI-compatible endpoint (LM Studio, vLLM, LiteLLM proxy, OpenRouter,
# DeepInfra, Together, Groq, Fireworks vb.). Aboneliğiniz olan bir servisi
# LiteLLM ile köprüleyip buradan kullanabilirsiniz.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_TEXT_MODEL=qwen/qwen3.5-9b
OPENAI_COMPAT_VISION_MODEL=qwen/qwen3-vl-8b
OPENAI_COMPAT_EMBED_MODEL=text-embedding-3-large

# ---- OCR ----
OCR_LANGS=tr,en

# ---- SMTP (mail / ticket) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sentinel@local
SMTP_TLS=true
TICKET_TO_EMAIL=destek@example.com

# ---- ProManage ----
PROMANAGE_BASE_URL=
PROMANAGE_USERNAME=
PROMANAGE_PASSWORD=
PROMANAGE_LOG_STREAM_URL=
# Yöntem: "websocket", "sse", "poll"
PROMANAGE_STREAM_MODE=poll
PROMANAGE_POLL_INTERVAL_SECONDS=5

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
