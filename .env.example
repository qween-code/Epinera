# ---- Genel ----
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-secret
TIMEZONE=Europe/Istanbul

# ---- Postgres ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@postgres:5432/sentinel

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Auth (tek kullanıcı) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---- AI Provider ----
# "openai_compat" | "ollama" | "anthropic"
# Varsayılan: OpenRouter (free modeller) + lokal Ollama (embedding için)
AI_PROVIDER=openai_compat
AI_FALLBACK_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# OpenRouter (https://openrouter.ai)
# Hesap aç → Keys → bir key oluştur → buraya yaz.
# free modeller için kullanım sınırı vardır ama ücret yoktur.
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPAT_API_KEY=
# Görev bazlı modeller — bkz docs/ai-models-curation.md
OPENAI_COMPAT_TEXT_MODEL=google/gemma-4-31b-it:free
OPENAI_COMPAT_VISION_MODEL=google/gemma-4-31b-it:free
OPENAI_COMPAT_TRIAGE_MODEL=liquid/lfm-2.5-1.2b-thinking:free
OPENAI_COMPAT_HEAVY_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Embedding free tier yoktur; boş bırakın → EMBEDDING_PROVIDER devreye girer.
OPENAI_COMPAT_EMBED_MODEL=
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_X_TITLE=Sentinel

# Ollama (lokal, embedding için kullanılır; chat için fallback)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TEXT_MODEL=qwen3.5:9b
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_EMBED_MODEL=bge-m3

# Anthropic API (opsiyonel)
ANTHROPIC_API_KEY=
AI_TEXT_MODEL=claude-opus-4-7
AI_VISION_MODEL=claude-opus-4-7

# ---- OCR ----
OCR_LANGS=tr,en

# ---- SMTP (mail / ticket) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sentinel@local
SMTP_TLS=true
TICKET_TO_EMAIL=destek@example.com

# ---- ProManage ----
PROMANAGE_BASE_URL=
PROMANAGE_USERNAME=
PROMANAGE_PASSWORD=
PROMANAGE_LOG_STREAM_URL=
PROMANAGE_STREAM_MODE=poll
PROMANAGE_POLL_INTERVAL_SECONDS=5

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
